{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "d1:create": "npx wrangler d1 create vyapaar-db",
    "d1:migrate": "npx wrangler d1 execute vyapaar-db --remote --file=migrations/0001_initial_schema.sql",
    "d1:migrate:local": "npx wrangler d1 execute vyapaar-db --local --file=migrations/0001_initial_schema.sql",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "dotenv": "^18.0.9",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "sql.js": "^1.15.2",
    "uuid": "^10.0.0"
  }
}
